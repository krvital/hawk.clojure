{:paths ["src"]
 :deps {cheshire/cheshire   {:mvn/version "6.2.0"}
        http-kit/http-kit   {:mvn/version "2.8.1"}
        metosin/malli       {:mvn/version "0.20.2"}
        org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {:dev {}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitext.test-runner.api/test}

  :nrepl {:extra-deps {cider/cider-nrepl             {:mvn/version "0.57.0"}
                       nrepl/nrepl                   {:mvn/version "1.5.1"}
                       org.clojure/clojure           {:mvn/version "1.12.0"}
                       refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
          :main-opts  ["-m" "nrepl.cmdline"
                       "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}
  :build {}}}
